# Required. Pooled connection string used by Prisma at runtime (via Neon's connection pooler).
DATABASE_URL=

# Required. Direct connection string used by Prisma for migrations and introspection (bypasses pooler).
DATABASE_URL_UNPOOLED=

# Optional. When set, the intake flow extracts invoice data from uploaded PDFs via Claude.
# When unset, extraction falls back to canned sample data keyed by filename (e.g. aws-invoice.pdf).
ANTHROPIC_API_KEY=

# Optional. When set, uploaded invoice PDFs are persisted to Vercel Blob and stored on Bill.pdfPath
# so the detail page renders the exact uploaded file. When unset, pdfPath is null and the detail
# page shows "No PDF attached". Provisioned via Vercel Dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=