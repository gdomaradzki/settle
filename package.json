{
  "name": "settle-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "dotenv -e .env.development.local -- prisma db push",
    "db:case-index": "dotenv -e .env.development.local -- prisma db execute --file ./prisma/sql/vendor-name-unique.sql",
    "db:seed": "dotenv -e .env.development.local -- prisma db seed",
    "db:setup": "npm run db:push && npm run db:case-index && npm run db:seed",
    "db:generate": "dotenv -e .env.development.local -- prisma generate",
    "verify": "dotenv -e .env.development.local -- node --conditions=react-server --require=./node_modules/tsx/dist/cjs/index.cjs scripts/verify-lifecycle.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.100.1",
    "@trpc/client": "^11.16.0",
    "@trpc/next": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@types/papaparse": "^5.5.2",
    "@vercel/blob": "^2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.9.0",
    "next": "16.3.0-canary.2",
    "next-devtools-mcp": "^0.3.10",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.73.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.4.0",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0-canary.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
